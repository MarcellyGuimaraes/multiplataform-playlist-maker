# Connection string do Neon (somente servidor — NUNCA use prefixo VITE_)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require

# E-mail de redefinição de senha via Gmail SMTP (somente servidor — NUNCA use prefixo VITE_).
# SMTP_APP_PASSWORD é uma "senha de app" do Google (exige verificação em 2 etapas na conta).
# Sem SMTP_USER, o link de redefinição só é registrado no console do servidor (útil no dev local).
# Exemplo: SMTP_USER=envios.playlist@gmail.com  e  SMTP_APP_PASSWORD=abcdabcdabcdabcd
SMTP_USER=
SMTP_APP_PASSWORD=

# Endereço público do app, usado para montar o link de redefinição de senha (sem barra no final).
APP_URL=http://localhost:5173
