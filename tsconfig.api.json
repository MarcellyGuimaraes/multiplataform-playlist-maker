{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api",
    "shared",
    "scripts",
    "tests"
  ],
  "exclude": [
    "tests/ui"
  ]
}
